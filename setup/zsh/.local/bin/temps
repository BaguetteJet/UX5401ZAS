#!/usr/bin/zsh
cpu=$(sensors | grep "Package id 0" | awk '{print $4}')
nvme=$(sensors | grep "Composite" | awk '{print $2}')
wifi=$(sensors | grep -A2 "iwlwifi" | grep "temp1" | awk '{print $2}')
asus=$(sensors | grep -A2 "^acpitz-acpi-0" | grep "temp1" | awk '{print $2}')
fan=$(sensors | grep "cpu_fan" | awk '{print $2}')
printf "CPU:  %s\n" "$cpu"
printf "NVMe: %s\n" "$nvme"
printf "WiFi: %s\n" "$wifi"
printf "ACPI: %s\n" "$asus"
printf "Fan:  %s RPM\n" "$fan"