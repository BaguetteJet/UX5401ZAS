#!/bin/sh
RAPL=/sys/class/powercap/intel-rapl-mmio:0

if [ "$(id -u)" -ne 0 ]; then
  exec sudo "$0" "$@"
fi

case "$1" in
  hi) echo 45000000 > $RAPL/constraint_0_power_limit_uw
      echo 60000000 > $RAPL/constraint_1_power_limit_uw ;;
  lo) echo 15000000 > $RAPL/constraint_0_power_limit_uw
      echo 25000000 > $RAPL/constraint_1_power_limit_uw ;;
  "") ;;
  *)  echo "Usage: cpu-power [hi|lo]"; exit 1 ;;
esac

echo "PL1: $(($(cat $RAPL/constraint_0_power_limit_uw) / 1000000)) W"
echo "PL2: $(($(cat $RAPL/constraint_1_power_limit_uw) / 1000000)) W"
